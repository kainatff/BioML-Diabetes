        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.metrics import confusion_matrix\n",
        "\n",
        "def plot_metric_comparison(pid_results, hfd_results):\n",
        "    \"\"\"\n",
        "    Plot comparison of metrics (MAE, Kappa, Accuracy) between PID and HFD datasets\n",
        "    for all classifiers used with Cuttlefish-selected features\n",
        "    \"\"\"\n",
        "    metrics = ['mae', 'kappa', 'accuracy']\n",
        "    metric_names = ['MAE', 'Kappa Score', 'Accuracy']\n",
        "    classifiers = list(pid_results.keys())\n",
        "\n",
        "    fig, axes = plt.subplots(1, 3, figsize=(20, 6))\n",
        "\n",
        "    for i, (metric, metric_name) in enumerate(zip(metrics, metric_names)):\n",
        "\n",
        "        pid_values = [pid_results[clf][metric] for clf in classifiers]\n",
        "        hfd_values = [hfd_results[clf][metric] for clf in classifiers]\n",
        "\n",
        "        x = np.arange(len(classifiers))\n",
        "        width = 0.35\n",
        "\n",
        "        bars1 = axes[i].bar(x - width/2, pid_values, width, label='PID', color='#1f77b4')\n",
        "        bars2 = axes[i].bar(x + width/2, hfd_values, width, label='HFD', color='#ff7f0e')\n",
        "\n",
        "        axes[i].set_xlabel('Classifier')\n",
        "        axes[i].set_ylabel(metric_name)\n",
        "        axes[i].set_title(f'{metric_name} Comparison: PID vs HFD')\n",
        "        axes[i].set_xticks(x)\n",
        "        axes[i].set_xticklabels(classifiers, rotation=45)\n",
        "        axes[i].legend()\n",
        "\n",
        "        for bar in bars1 + bars2:\n",
        "            height = bar.get_height()\n",
        "            axes[i].text(bar.get_x() + bar.get_width()/2., height,\n",
        "                        f'{height:.3f}',\n",
        "                        ha='center', va='bottom')\n",
        "\n",
        "        # special handling for MAE (lower is better)\n",
        "        if metric == 'mae':\n",
        "            axes[i].invert_yaxis()\n",
        "            axes[i].set_ylabel('MAE (Lower is better)')\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.savefig('pid_vs_hfd_metrics_comparison.png')\n",
        "    plt.show()\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    classifier = DiabetesClassifier()\n",
        "\n",
        "    experiments = [\n",
        "        {'name': 'PID', 'path': 'diabetes.csv', 'features': [1, 2, 6, 7]},\n",
        "        {'name': 'HFD', 'path': 'diabetes2.csv', 'features': [2, 3, 6, 8]}\n",
        "    ]\n",
        "\n",
        "    all_results = {}\n",
        "\n",
        "    for exp in experiments:\n",
        "        X, y = classifier.load_data(exp['path'])\n",
        "        X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)\n",
        "        results = classifier.evaluate_classifiers(X_train, X_test, y_train, y_test, exp['features'])\n",
        "        all_results[exp['name']] = results\n",
        "\n",
        "    plot_metric_comparison(all_results['PID'], all_results['HFD'])"
